{
  "name": "react-hooks-cli",
  "version": "0.1.0",
  "description": "CLI for adding React hooks to your project",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "react-hooks-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "eslint src/**/*.ts",
    "generate-templates": "ts-node scripts/generate-templates.ts",
    "prebuild": "npm run generate-templates"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "inquirer": "^9.2.10",
    "chalk": "^5.3.0",
    "fs-extra": "^11.1.1",
    "axios": "^1.4.0",
    "ora": "^7.0.1",
    "conf": "^11.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.3",
    "@types/node": "^20.5.9",
    "@types/fs-extra": "^11.0.1",
    "eslint": "^8.48.0",
    "tsup": "^7.2.0",
    "typescript": "^5.2.2"
  }
}