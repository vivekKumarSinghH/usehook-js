{
  "name": "usehook-js-monorepo",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint && eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "check:zero-deps": "tsx scripts/check-zero-deps.ts",
    "size": "size-limit"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@size-limit/file": "^13.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "size-limit": "^13.0.3",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0"
  }
}
