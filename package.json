{
  "name": "react-hooks-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"

  },
  "devDependencies": {
    "prettier": "^3.0.3",
    "turbo": "latest",
    "eslint": "^8.48.0",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@8.6.10",
  "engines": {
    "node": ">=18"
  }
}